# ---------------------------------------------------------------------------
# このファイルは雛形です。実値は .env.local に書いてください（gitignore 済み）。
# .env.local はコミットされません。値をチャットや Issue に貼る必要もありません。
# ---------------------------------------------------------------------------

# S1〜S6 で必要
# Supabase ダッシュボード > Settings > API（Data API）の Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase ダッシュボード > Settings > API Keys > Publishable and secret API keys
# publishable キー（sb_publishable_... で始まる）。ブラウザに露出する前提の鍵。
# RLS が有効な限り公開されて問題ない。変数名は Vercel 連携が自動生成する名前に合わせている。
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# 任意。ログイン用リンクの組み立てに使う絶対 URL。
# 通常は Origin ヘッダーから自動で決まるため設定は不要。
# ヘッダーが取れない環境で明示したい場合のみ設定する（末尾のスラッシュは付けない）。
# NEXT_PUBLIC_SITE_URL=https://tasquest.example.vercel.app

# ---------------------------------------------------------------------------
# ここから下は S7（日次の自動生成）に着手するまで不要。
# 取得を先延ばしにしてよい。
# ---------------------------------------------------------------------------

# secret キー（sb_secret_... で始まる）。RLS をバイパスする。
# ブラウザに渡さないこと。サーバー側の cron からのみ使う。
# SUPABASE_SECRET_KEY=

# Vercel Cron のエンドポイントを外部から叩かれないようにするための共有シークレット。
# 任意の長いランダム文字列でよい（例: openssl rand -hex 32）。
# CRON_SECRET=

# Gemini API キー。
# GEMINI_API_KEY=
